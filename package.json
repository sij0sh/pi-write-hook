  },
  "homepage": "https://github.com/sij0sh/pi-write-hook#readme",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "24.0.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "scripts": {
